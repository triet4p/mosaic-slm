    "ToolEvidence": {
      "additionalProperties": false,
      "description": "Mot tool call da chay, dung lam evidence cho recommendation/decision.\n\nHinh dang khop ``ToolCallRecord`` cua single-agent runner de tai dung\npattern hien co; ``tool`` phai thuoc ``KNOWN_TOOLS``.",
      "properties": {
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "success": {
          "default": true,
          "title": "Success",
          "type": "boolean"
        },
        "result": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result"
        }
      },
      "required": [
        "tool"
      ],
      "title": "ToolEvidence",
      "type": "object"
    },
