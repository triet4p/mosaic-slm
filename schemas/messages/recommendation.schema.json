  "additionalProperties": false,
  "description": "De xuat cua analyst; ``proposed_actions`` chi la de xuat.\n\nKhong duoc dua ``proposed_actions`` truc tiep vao ``ActionExecutor``.",
  "properties": {
    "message_type": {
      "const": "recommendation",
      "default": "recommendation",
      "title": "Message Type",
      "type": "string"
    },
    "message_id": {
      "minLength": 1,
      "title": "Message Id",
      "type": "string"
    },
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "episode_seed": {
      "title": "Episode Seed",
      "type": "integer"
    },
    "day": {
      "minimum": 1,
      "title": "Day",
      "type": "integer"
    },
    "role": {
      "$ref": "#/$defs/AgentRole"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "proposed_actions": {
      "items": {
        "$ref": "#/$defs/BusinessAction"
      },
      "minItems": 1,
      "title": "Proposed Actions",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/ToolEvidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "confidence": {
      "default": 0.5,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    }
  },
  "required": [
    "message_id",
    "request_id",
    "episode_seed",
    "day",
    "role",
    "summary",
    "proposed_actions",
    "evidence"
  ],
  "title": "AnalystRecommendation",
  "type": "object"
}
