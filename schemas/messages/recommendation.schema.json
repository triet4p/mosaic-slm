          "$ref": "#/$defs/NoAction"
        },
        {
          "$ref": "#/$defs/PlaceOrder"
        },
        {
          "$ref": "#/$defs/TransferStock"
        },
        {
          "$ref": "#/$defs/SwitchSupplier"
        },
        {
          "$ref": "#/$defs/AdjustSafetyStock"
        },
